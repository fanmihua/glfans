# 运行账号只需要 glfans 数据库的 SELECT/INSERT/UPDATE/DELETE 权限。
GLFANS_DB_HOST=127.0.0.1
GLFANS_DB_PORT=3306
GLFANS_DB_NAME=glfans
GLFANS_DB_USER=glfans_app
GLFANS_DB_PASSWORD=replace-with-a-random-database-password

# 至少 32 个随机字符，用于 HMAC 会话、CSRF 与匿名化 IP 限流键；上线后不可随意更换。
GLFANS_SECURITY_SECRET=replace-with-at-least-32-random-characters
GLFANS_ALLOWED_ORIGINS=https://glfans.com,https://www.glfans.com
GLFANS_COOKIE_SECURE=true
GLFANS_PORT=3100

# 仅迁移时可临时提供有 CREATE/ALTER 权限的账号；API 进程不需要这两个变量。
GLFANS_MIGRATION_DB_USER=glfans_migrator
GLFANS_MIGRATION_DB_PASSWORD=replace-with-a-separate-migration-password

# 只在运行 npm run db:admin 的当前 shell 临时设置，不要写入长期环境文件。
# GLFANS_ADMIN_EMAIL=admin@example.com
# GLFANS_ADMIN_PASSWORD=replace-with-a-long-unique-password
