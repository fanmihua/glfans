{
  "name": "glfans",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://glfans.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/fanmihua/glfans.git"
  },
  "bugs": {
    "url": "https://github.com/fanmihua/glfans/issues"
  },
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-column-index.mjs",
    "prebuild": "node scripts/build-column-index.mjs",
    "sync:netease": "node scripts/sync-netease-playlist.mjs",
    "sync:schedule": "node scripts/sync-archive-schedule.mjs",
    "stats:schedule": "node scripts/report-archive-schedule.mjs",
    "test:schedule": "node --test tests/archive-schedule.test.mjs tests/archive-history.test.mjs",
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "rights:inventory": "node scripts/build-media-rights-inventory.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "sync:history": "node scripts/sync-archive-history.mjs",
    "start:api": "node server/index.js",
    "db:migrate": "node scripts/migrate-glfans-db.mjs",
    "db:seed": "node scripts/seed-glfans-db.mjs",
    "db:init": "npm run db:migrate && npm run db:seed",
    "db:import": "node scripts/import-glfans-community.mjs",
    "db:admin": "node scripts/create-glfans-admin.mjs",
    "test:server": "node --test server/tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@fontsource-variable/roboto-condensed": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "express": "^5.2.1",
    "mysql2": "^3.24.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "^6.4.3"
  }
}
