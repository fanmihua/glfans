# Final glfans virtual host. It is intentionally isolated from every existing
# site: unique server_name, document root, logs and upstream port.
server {
    listen 80;
    listen [::]:80;
    server_name glfans.com www.glfans.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt-glfans;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://glfans.com$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.glfans.com;

    ssl_certificate /etc/letsencrypt-glfans/live/glfans.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt-glfans/live/glfans.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:GLFANS_TLS:10m;
    ssl_session_tickets off;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=15552000" always;
    return 301 https://glfans.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name glfans.com;

    root /var/www/glfans/current;
    index index.html;
    server_tokens off;
    etag on;

    access_log /var/log/nginx/glfans.access.log;
    error_log /var/log/nginx/glfans.error.log warn;

    ssl_certificate /etc/letsencrypt-glfans/live/glfans.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt-glfans/live/glfans.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:GLFANS_TLS:10m;
    ssl_session_tickets off;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=15552000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css text/plain application/javascript application/json application/wasm image/svg+xml;

    # Keep the /api prefix when forwarding to the local, single-instance API.
    location = /api {
        return 404;
    }

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_hide_header X-Powered-By;
        client_max_body_size 1m;
    }

    location = /index.html {
        expires -1;
        try_files $uri =404;
    }

    location ~* \.glb$ {
        types { model/gltf-binary glb; }
        expires 30d;
        access_log off;
        try_files $uri =404;
    }

    location ~* \.wasm$ {
        types { application/wasm wasm; }
        expires 30d;
        access_log off;
        try_files $uri =404;
    }

    location ~* \.(?:js|mjs|css)$ {
        expires 1y;
        access_log off;
        try_files $uri =404;
    }

    location ~* \.(?:avif|gif|ico|jpe?g|png|svg|webp|woff2?|mp3|mp4|ogg|webm)$ {
        expires 30d;
        access_log off;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~ /\. {
        deny all;
    }
}
